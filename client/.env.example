# Frontend build configuration (Vite). Safe template — commit this file, never
# a real .env. Everything here is inlined into the PUBLIC JavaScript bundle at
# build time, so NO SECRETS BELONG IN THIS FILE OR IN client/.env: no API keys,
# no tokens, no credentials. Those stay server-side only.

# Base URL of the backend API, including the /api suffix.
#
# Leave UNSET for local development: api.js falls back to '/api' and the Vite
# dev server proxies it to the backend on http://localhost:5000.
#
# Set it for a production build when the frontend and backend are on different
# origins (e.g. the site on Hostinger, the API on Render):
#   VITE_API_URL=https://your-app.onrender.com/api
VITE_API_URL=
