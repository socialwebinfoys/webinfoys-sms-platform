# Copy this file to .env and fill in real values. Never commit .env.

# Server
# NODE_ENV MUST be set to "production" in any production deployment. In
# production the API suppresses error stack traces and internal error details
# from HTTP responses; any other value (including leaving it unset, which
# defaults to "development") exposes stack traces to clients. Use "development"
# only for local work.
NODE_ENV=development
PORT=5000

# Allowed CORS origin(s) for the React client. Accepts a comma-separated list,
# e.g. CORS_ORIGIN=https://app.webinfoys.com,https://staging.webinfoys.com
# "*" is permitted ONLY in development — in production startup fails if it is
# used, and CORS_ORIGIN itself becomes REQUIRED.
# It must be the frontend ORIGIN exactly as the browser sends it: scheme://host,
# no path. For production: CORS_ORIGIN=https://sms.webinfoys.com
# (That origin is also always allowed by the code, so a host left on the
# development value below cannot lock the real site out.)
CORS_ORIGIN=http://localhost:5173

# Optional default country code for phone numbers imported without one (e.g. +1).
# Leave blank to require full E.164 numbers.
DEFAULT_COUNTRY_CODE=

# Twilio credentials (required to actually send/receive SMS). Never commit real
# values. Leave blank and use SMS_SIMULATE=true for local development.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Set to true to simulate outbound sends without contacting Twilio (dev/testing).
SMS_SIMULATE=false

# Set to true to simulate Twilio Lookup calls (dev/testing without credentials).
LOOKUP_SIMULATE=false

# Validate the X-Twilio-Signature on inbound webhooks. Set to false only for
# local testing without real signatures. In production the server REFUSES TO
# START if this is false.
TWILIO_VALIDATE_WEBHOOK=true

# Public base URL used when checking webhook signatures (e.g. a tunnel in
# development). REQUIRED in production, where it must be an https:// URL and
# IDENTICAL to PUBLIC_API_URL below.
TWILIO_WEBHOOK_BASE_URL=

# --- Automation engine (Phase 5) ---
# Starts the scheduled worker that sends campaign steps and follow-ups.
#   * In PRODUCTION (NODE_ENV=production) it is opt-IN: the worker starts only
#     when this is exactly "true". Leave it false for a first deployment and
#     switch it on deliberately once everything has been checked.
#   * In development it starts unless this is exactly "false".
# This is the scheduler only, not a sending kill switch: turn off "SMS
# enabled" in Settings (or use SMS_SIMULATE=true) to stop all sending.
AUTOMATION_ENABLED=false
# Cron schedule for the worker tick (default: every minute).
AUTOMATION_CRON=* * * * *
# Throttle: max enrollments processed per run.
AUTOMATION_MAX_SENDS_PER_RUN=20
# Retry: max attempts per step before the enrollment is failed.
AUTOMATION_MAX_RETRIES=3
# Base backoff (minutes) between retries (grows exponentially).
AUTOMATION_RETRY_BACKOFF_MINUTES=5
# Sending window (start/end hour + IANA timezone) is configured at runtime via
# PUT /api/settings/automation (defaults: 09:00-18:00 UTC).

# Public base URL of THIS API, used to build the Twilio delivery status callback
# (Phase 3). REQUIRED when NODE_ENV=production — startup fails without it.
# Leave empty in development: sends still work, delivery receipts are just not
# received. In production it must be an https:// URL and IDENTICAL to
# TWILIO_WEBHOOK_BASE_URL. Example: https://your-app.onrender.com
PUBLIC_API_URL=

# How long a graceful shutdown (a deploy or restart) waits for a running worker
# pass and open requests before exiting anyway, in milliseconds. Must be shorter
# than the host kill delay (Render: 30 seconds unless raised). Default 20000.
SHUTDOWN_TIMEOUT_MS=

# --- AI reply system (Phase 8) ---
# Encrypts provider API keys (Gemini / Groq / OpenAI) before they are stored in
# MongoDB. REQUIRED before an API key can be saved, and required at startup when
# AI_WORKER_ENABLED=true. Must be at least 32 characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it makes every stored provider key unreadable — they must be re-entered.
# NEVER commit a real value.
AI_ENCRYPTION_KEY=

# Starts the AI reply worker. Opt-IN: only the literal "true" enables it, so the
# worker stays off unless you ask for it. Deliberately separate from
# AUTOMATION_ENABLED so AI replies and campaign automation are operated
# independently. NOTE: this only starts the SCHEDULER — the master switch is
# "AI enabled" in Settings, which is false by default.
AI_WORKER_ENABLED=false
# Cron schedule for the AI worker tick (default: every minute).
AI_WORKER_CRON=* * * * *
# Throttle: max AI jobs processed per run.
AI_MAX_JOBS_PER_RUN=10
# Retry: max attempts per job before it is failed.
AI_MAX_RETRIES=3
# Base backoff (minutes) between retries (grows exponentially).
AI_RETRY_BACKOFF_MINUTES=2
# How long one provider call may take before it is abandoned (milliseconds).
AI_REQUEST_TIMEOUT_MS=20000

# --- AI reply system (Phase 8.1) ---
# Budget for POST /api/ai/test, which spends provider credit on every call.
# Counted PER ADMIN, not per IP. Leave both unset to use the defaults: 10 calls
# per 15 minutes in production, 30 otherwise.
AI_TEST_RATE_LIMIT_MAX=
AI_TEST_RATE_LIMIT_WINDOW_MINUTES=

# MongoDB connection string (local MongoDB or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/webinfoys_sms

# JWT authentication.
# JWT_SECRET must be at least 32 characters (startup fails if it is shorter).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it invalidates every existing session — all users must log in again.
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_characters
JWT_EXPIRES_IN=7d

# Initial admin account (used only by: npm run seed:admin).
# ADMIN_PASSWORD must be at least 12 characters.
ADMIN_NAME=Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_this_password
